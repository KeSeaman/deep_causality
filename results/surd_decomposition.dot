  "HCO3" -- "S_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "S_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Hgb" -- "S_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "S_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "S_Resp_HCO3_Temp_Hgb_HR" -- label [color="#1baf7a", penwidth=6.00];
  "S_HCO3_Temp_Hgb_HR" [label="Synergistic\nHCO3, Temp, Hgb, HR\n5.2e-04 bits", color="#1baf7a", fontsize=9];
