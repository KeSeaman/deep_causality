  "HCO3" -- "S_Resp_HCO3_Temp" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "S_Resp_HCO3_Temp" [color="#d6d5cf", penwidth=0.8];
  "S_Resp_HCO3_Temp" -- label [color="#1baf7a", penwidth=1.71];
  "S_Temp_Hgb_HR" [label="Synergistic\nTemp, Hgb, HR\n2.1e-04 bits", color="#1baf7a", fontsize=9];
  "Temp" -- "S_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Hgb" -- "S_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "S_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "S_Temp_Hgb_HR" -- label [color="#1baf7a", penwidth=1.65];
  "S_Resp_HCO3_Temp_Hgb" [label="Synergistic\nResp, HCO3, Temp, Hgb\n1.9e-04 bits", color="#1baf7a", fontsize=9];
