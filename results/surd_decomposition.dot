  "HCO3" -- "R_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "R_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Hgb" -- "R_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "R_Resp_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "R_Resp_HCO3_Temp_Hgb_HR" -- label [color="#eb6834", penwidth=2.05];
  "R_Resp_Temp_Hgb_HR" [label="Redundant\nResp, Temp, Hgb, HR\n1.3e-04 bits", color="#eb6834", fontsize=9];
  "Resp" -- "R_Resp_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "R_Resp_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Hgb" -- "R_Resp_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "R_Resp_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "R_Resp_Temp_Hgb_HR" -- label [color="#eb6834", penwidth=1.40];
  "R_Resp_Temp" [label="Redundant\nResp, Temp\n7.0e-05 bits", color="#eb6834", fontsize=9];
  "Resp" -- "R_Resp_Temp" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "R_Resp_Temp" [color="#d6d5cf", penwidth=0.8];
  "R_Resp_Temp" -- label [color="#eb6834", penwidth=1.22];
  "S_Resp_HCO3_Temp_Hgb_HR" [label="Synergistic\nall five\n1.6e-03 bits", color="#1baf7a", fontsize=9];
