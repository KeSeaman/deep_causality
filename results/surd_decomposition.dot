  "Temp" -- "S_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Hgb" -- "S_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "S_HCO3_Temp_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "S_HCO3_Temp_Hgb_HR" -- label [color="#1baf7a", penwidth=2.65];
  "S_Resp_HR" [label="Synergistic\nResp, HR\n2.9e-04 bits", color="#1baf7a", fontsize=9];
  "Resp" -- "S_Resp_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "S_Resp_HR" [color="#d6d5cf", penwidth=0.8];
  "S_Resp_HR" -- label [color="#1baf7a", penwidth=1.90];
  "S_Resp_Temp" [label="Synergistic\nResp, Temp\n2.3e-04 bits", color="#1baf7a", fontsize=9];
  "Resp" -- "S_Resp_Temp" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "S_Resp_Temp" [color="#d6d5cf", penwidth=0.8];
  "S_Resp_Temp" -- label [color="#1baf7a", penwidth=1.71];
