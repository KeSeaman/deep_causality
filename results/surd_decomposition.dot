  "HCO3" -- "S_Resp_HCO3_Temp_Hgb" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "S_Resp_HCO3_Temp_Hgb" [color="#d6d5cf", penwidth=0.8];
  "Hgb" -- "S_Resp_HCO3_Temp_Hgb" [color="#d6d5cf", penwidth=0.8];
  "S_Resp_HCO3_Temp_Hgb" -- label [color="#1baf7a", penwidth=1.61];
  "S_Resp_HCO3_Hgb_HR" [label="Synergistic\nResp, HCO3, Hgb, HR\n1.8e-04 bits", color="#1baf7a", fontsize=9];
  "Resp" -- "S_Resp_HCO3_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "HCO3" -- "S_Resp_HCO3_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "Hgb" -- "S_Resp_HCO3_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "S_Resp_HCO3_Hgb_HR" [color="#d6d5cf", penwidth=0.8];
  "S_Resp_HCO3_Hgb_HR" -- label [color="#1baf7a", penwidth=1.58];
  "S_HCO3_HR" [label="Synergistic\nHCO3, HR\n1.8e-04 bits", color="#1baf7a", fontsize=9];
  "HCO3" -- "S_HCO3_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "S_HCO3_HR" [color="#d6d5cf", penwidth=0.8];
  "S_HCO3_HR" -- label [color="#1baf7a", penwidth=1.55];
  "S_Temp_HR" [label="Synergistic\nTemp, HR\n1.6e-04 bits", color="#1baf7a", fontsize=9];
  "Temp" -- "S_Temp_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "S_Temp_HR" [color="#d6d5cf", penwidth=0.8];
  "S_Temp_HR" -- label [color="#1baf7a", penwidth=1.51];
  other [label="Synergistic\n16 smaller sets\n7.6e-04 bits in total", color="#1baf7a", fontsize=9, style="filled,rounded,dashed"];
