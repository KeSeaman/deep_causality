graph SURD {
  graph [rankdir=LR, bgcolor="#fcfcfb", fontname="Helvetica", fontsize=13, fontcolor="#0b0b0b", label="SURD on hospital A: what five vital/lab drivers tell us about the 6-hour sepsis label\nJointly 0.0061 of 0.1508 bits (4%); unique 0.0001 · redundant 0.0014 · synergistic 0.0045 bits", labelloc=t, nodesep=0.12, ranksep=1.1, pad=0.3, ordering=out];
  node [fontname="Helvetica", fontsize=10, fontcolor="#0b0b0b", style="filled,rounded", fillcolor="white", shape=box, penwidth=1.5];
  edge [color="#c3c2b7"];
  label [label="Sepsis within 6 h\n(H = 0.151 bits)", shape=ellipse, color="#0b0b0b", penwidth=2];
  "Resp" [label="Resp", color="#52514e"];
  "HCO3" [label="HCO3", color="#52514e"];
  "Temp" [label="Temp", color="#52514e"];
  "Hgb" [label="Hgb", color="#52514e"];
  "HR" [label="HR", color="#52514e"];
  "U_Temp" [label="Unique\nTemp\n1.0e-04 bits", color="#2a78d6", fontsize=9];
  "Temp" -- "U_Temp" [color="#d6d5cf", penwidth=0.8];
  "U_Temp" -- label [color="#2a78d6", penwidth=1.32];
  "R_Resp_Temp_HR" [label="Redundant\nResp, Temp, HR\n9.2e-04 bits", color="#eb6834", fontsize=9];
  "Resp" -- "R_Resp_Temp_HR" [color="#d6d5cf", penwidth=0.8];
  "Temp" -- "R_Resp_Temp_HR" [color="#d6d5cf", penwidth=0.8];
  "HR" -- "R_Resp_Temp_HR" [color="#d6d5cf", penwidth=0.8];
  "R_Resp_Temp_HR" -- label [color="#eb6834", penwidth=3.90];
  "R_Resp_HCO3_Temp_Hgb_HR" [label="Redundant\nall five\n3.3e-04 bits", color="#eb6834", fontsize=9];
